# Rol dueño de las tablas: solo para correr migraciones.
DATABASE_URL_MIGRACIONES="postgresql://deoco_owner:CLAVE@localhost:5432/deoco"
# Rol de la aplicación (deoco_app): sin BYPASSRLS, sin superusuario.
DATABASE_URL="postgresql://deoco_app:CLAVE@localhost:5432/deoco"

# Dominio raíz de la plataforma: deocoartist.com en producción, lvh.me en desarrollo.
DEOCO_DOMINIO_RAIZ="lvh.me"

# Auth.js: secreto para firmar/cifrar la sesión. Generar con: npx auth secret
AUTH_SECRET="CAMBIAR"

# Almacén de archivos: "disco" (único por ahora). En Easypanel, montar un volumen en DEOCO_ARCHIVOS_DIR.
DEOCO_ALMACEN="disco"
DEOCO_ARCHIVOS_DIR=".archivos"
# Espacio por banda si tenant.limiteAlmacenamiento es null (bytes). 1 GiB.
DEOCO_LIMITE_ALMACENAMIENTO="1073741824"

# Back office (/admin): rol deoco_admin, BYPASSRLS. Solo lo usa src/app/admin.
DATABASE_URL_ADMIN="postgresql://deoco_admin:CLAVE@localhost:5432/deoco"

# Cifrado de credenciales por banda (token de pasarela, etc.). 32 bytes en base64:
#   openssl rand -base64 32
# FIJA: si cambia, las credenciales guardadas no se pueden leer y hay que volver a cargarlas.
DEOCO_CLAVE_SECRETOS="CAMBIAR"
# Solo durante una rotación de la clave (docs/despliegue.md, "Rotar la clave de secretos").
# DEOCO_CLAVE_SECRETOS_ANTERIOR=""

# Firma de los QR de las entradas (ticketera). 32 bytes en base64: openssl rand -base64 32
# FIJA: si cambia, las entradas ya vendidas dejan de pasar la puerta.
DEOCO_CLAVE_QR="CAMBIAR"

# Correo: "memoria" en desarrollo (no sale, se loguea); "smtp" en producción.
DEOCO_CORREO="memoria"
# DEOCO_SMTP_URL="smtps://resend:CLAVE@smtp.resend.com:465"
# DEOCO_CORREO_REMITENTE="tiendas@deocoartist.com"
