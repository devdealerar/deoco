{
  "name": "deoco",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "postinstall": "prisma generate && node scripts/descubrir-modulos.mjs",
    "db:semilla": "tsx prisma/semilla.ts",
    "db:migrate:test": "dotenv -e .env.test -o -- prisma migrate deploy",
    "test:e2e": "vitest run --config vitest.e2e.config.mts",
    "modulos:descubrir": "node scripts/descubrir-modulos.mjs",
    "predev": "node scripts/descubrir-modulos.mjs",
    "prebuild": "node scripts/descubrir-modulos.mjs --produccion",
    "pretest": "node scripts/descubrir-modulos.mjs",
    "pretest:e2e": "node scripts/descubrir-modulos.mjs",
    "pretypecheck": "node scripts/descubrir-modulos.mjs"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "dotenv": "^18.0.7",
    "next": "16.4.0",
    "next-auth": "^5.0.0-beta.32",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "playwright-core": "^1.64.0",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.4"
  }
}
