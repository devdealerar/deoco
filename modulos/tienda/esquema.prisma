// Módulo tienda. Dos clases de tablas:
//  - Globales (/// @global, sin tenantId): proveedores y catálogo base, iguales para todas
//    las bandas. Las escribe el staff desde el back office (conStaff).
//  - De banda (con tenantId, RLS): sus productos y sus pedidos.
// Dinero: en centavos (Int). Solo pesos argentinos.

/// @global
/// Proveedor que produce y envía. Le llegan las órdenes por mail.
model TiendaProveedor {
  id         String   @id @default(uuid()) @db.Uuid
  nombre     String
  /// Al que llegan las órdenes de producción.
  email      String
  /// Persona de contacto.
  contacto   String   @default("")
  /// Formatos de impresión que acepta: "png" (alta resolución) y/o "pdf". SVG no.
  formatos   String[]
  activo     Boolean  @default(true)
  /// El de la plataforma: lo usa todo producto base sin proveedor propio. Uno solo (índice parcial).
  porDefecto Boolean  @default(false)
  creadoEn   DateTime @default(now())

  productosBase TiendaProductoBase[]
  deudas        TiendaDeuda[]
  ordenes       TiendaOrden[]

  @@map("tienda_proveedor")
}

/// @global
/// Producto del catálogo base (remera, buzo, vinilo, poster). La banda arma los suyos a partir de estos.
model TiendaProductoBase {
  id                  String   @id @default(uuid()) @db.Uuid
  nombre              String
  descripcion         String   @default("")
  /// Foto (archivo de plataforma).
  fotoArchivoId       String?  @db.Uuid
  fotoNombre          String?
  /// Variantes: [{ "nombre": "Talle", "valores": ["S", "M"] }, { "nombre": "Color", "valores": [...] }]
  opciones            Json     @default("[]")
  /// Lo que cobra el proveedor por producir uno. Vale el vigente al pagarse cada pedido.
  costoProduccion     Int
  /// Envío, fijo por producto. Vale el vigente al pagarse cada pedido.
  costoEnvio          Int
  /// Preparado para envío por zonas (sin uso todavía): { "<zona>": centavos }.
  costoEnvioPorZona   Json?
  /// Si es null, el proveedor por defecto de la plataforma.
  proveedorId         String?  @db.Uuid
  proveedor           TiendaProveedor? @relation(fields: [proveedorId], references: [id], onDelete: Restrict)
  /// Archivo de impresión que tiene que subir la banda.
  impresionAnchoPx    Int
  impresionAltoPx     Int
  impresionDpi        Int
  impresionFormatos   String[]
  /// Desactivado: no se usa en productos nuevos; los que ya existen siguen.
  activo              Boolean  @default(true)
  creadoEn            DateTime @default(now())
  actualizadoEn       DateTime @default(now()) @updatedAt

  productos TiendaProducto[]
  items     TiendaPedidoItem[]

  @@map("tienda_producto_base")
}

/// Archivo de impresión de la banda (PNG de alta o PDF). Un diseño sirve para varios productos.
/// Guarda lo que se midió al subirlo, para validar contra cada producto base.
model TiendaDiseno {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  nombre        String
  /// Archivo privado de la banda (al proveedor le llega con un link firmado).
  archivoId     String   @db.Uuid
  archivoNombre String
  /// "png" | "pdf"
  formato       String
  /// PNG: píxeles y resolución declarada (dpi; null si el archivo no la trae).
  anchoPx       Int?
  altoPx        Int?
  dpi           Int?
  /// PDF: tamaño de la primera página, en puntos (1/72 pulgada).
  anchoPt       Float?
  altoPt        Float?
  /// PNG: hay versión liviana para ver en el panel.
  conVistaPrevia Boolean @default(false)
  creadoEn      DateTime @default(now())

  productos TiendaProducto[]

  @@unique([tenantId, id])
  @@index([tenantId])
  @@map("tienda_diseno")
}

/// Producto de una banda, hecho a partir de un producto base y un diseño.
model TiendaProducto {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  productoBaseId String   @db.Uuid
  productoBase   TiendaProductoBase @relation(fields: [productoBaseId], references: [id], onDelete: Restrict)
  disenoId       String   @db.Uuid
  /// Clave foránea compuesta (banda, diseño): la base no deja usar un diseño de otra banda.
  diseno         TiendaDiseno @relation(fields: [tenantId, disenoId], references: [tenantId, id], onDelete: Restrict)
  nombre         String
  descripcion    String   @default("")
  /// Precio al fan, envío incluido (centavos).
  precio         Int
  /// Variantes que ofrece, subconjunto de las del base: [{ "nombre": "Talle", "valores": ["S", "M"] }]
  variantes      Json     @default("[]")
  /// Foto propia (archivo de la banda, público al publicar). Sin foto: la del producto base.
  fotoArchivoId  String?  @db.Uuid
  fotoNombre     String?
  /// Borrador (false) no se ve en la tienda.
  publicado      Boolean  @default(false)
  creadoEn       DateTime @default(now())
  actualizadoEn  DateTime @default(now()) @updatedAt

  items TiendaPedidoItem[]

  @@unique([tenantId, id])
  @@index([tenantId, publicado])
  @@map("tienda_producto")
}

/// PENDIENTE: esperando el pago. PAGADO: pago aprobado y verificado contra la pasarela.
/// EN_REVISION: la pasarela aprobó un pago que no coincide (monto o moneda): hay que revisarlo.
/// CANCELADO: reservado. DESPACHADO: todos sus proveedores lo despacharon (panel del proveedor).
/// No hay ENTREGADO: el proveedor no tiene cómo saberlo de verdad (lo sabe el correo).
enum TiendaEstadoPedido {
  PENDIENTE
  PAGADO
  EN_REVISION
  CANCELADO
  DESPACHADO
}

/// Pedido de un fan. Se crea PENDIENTE al confirmar el checkout, con su copia de precios.
model TiendaPedido {
  id        String             @id @default(uuid()) @db.Uuid
  tenantId  String             @db.Uuid
  estado    TiendaEstadoPedido @default(PENDIENTE)
  /// Datos del fan (no hay cuenta de fan: viven en el pedido).
  nombre    String
  email     String
  telefono  String
  calle     String
  numero    String
  piso      String             @default("")
  ciudad    String
  provincia String
  codigoPostal String
  /// Preparado para envío por zonas (sin uso todavía).
  zonaEnvio String?
  /// Copias al crearse (centavos): suma de precios, envío y total. Envío: uno por proveedor (el
  /// mayor de sus renglones); `envios` lo desglosa: [{ "proveedorId", "monto", "productos": [..] }].
  subtotal  Int
  envio     Int
  envios    Json               @default("[]")
  total     Int
  creadoEn  DateTime           @default(now())
  pagadoEn  DateTime?
  /// Cobro en la pasarela de la banda.
  pasarela      String?
  /// Id del cobro creado (preferencia en Mercado Pago) y adónde va el fan a pagar.
  preferenciaId String?
  urlPago       String?
  /// Id del pago aprobado (el que lo marcó PAGADO) y lo último que dijo la pasarela.
  cobroId       String?
  estadoCobro   String?
  /// Por qué quedó EN_REVISION (monto o moneda distintos).
  observacion   String?
  /// Secreto para ver el pedido y pagarlo (cookie del navegador que compró o link del mail).
  token         String

  items       TiendaPedidoItem[]
  deudas      TiendaDeuda[]
  ordenes     TiendaOrden[]

  @@unique([tenantId, id])
  @@index([tenantId, estado])
  @@map("tienda_pedido")
}

/// Un renglón del pedido. Precio y envío al fan: copias al crearse el pedido. Costo de
/// producción, envío del proveedor y proveedor: copias al pagarse (cambiar el catálogo después
/// no cambia lo vendido).
model TiendaPedidoItem {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @db.Uuid
  pedidoId        String   @db.Uuid
  /// Claves foráneas compuestas (banda, …): la base no deja mezclar bandas en un pedido.
  pedido          TiendaPedido @relation(fields: [tenantId, pedidoId], references: [tenantId, id], onDelete: Cascade)
  productoId      String   @db.Uuid
  producto        TiendaProducto @relation(fields: [tenantId, productoId], references: [tenantId, id], onDelete: Restrict)
  productoBaseId  String   @db.Uuid
  productoBase    TiendaProductoBase @relation(fields: [productoBaseId], references: [id], onDelete: Restrict)
  /// Nombre del producto al comprarse (para el resumen y los mails).
  nombreProducto  String
  /// Selección: { "Talle": "M", "Color": "Negro" }
  variante        Json
  cantidad        Int
  /// Lo que paga el fan por unidad, al crearse el pedido.
  precioUnitario  Int
  envioUnitario   Int
  /// Copias fijadas al pagarse (null mientras el pedido no está pagado).
  costoProduccion Int?
  costoEnvio      Int?
  proveedorId     String?  @db.Uuid

  @@index([tenantId, pedidoId])
  @@index([proveedorId])
  @@map("tienda_pedido_item")
}

/// Lo que la banda le debe a un proveedor por un pedido pagado: producción de sus renglones más
/// un envío (el mayor de sus renglones: lo despacha en un paquete). Se registra al pagarse, una
/// sola vez por (pedido, proveedor). Deoco solo lleva la cuenta: no cobra ni mueve esa plata.
model TiendaDeuda {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  pedidoId    String   @db.Uuid
  pedido      TiendaPedido @relation(fields: [tenantId, pedidoId], references: [tenantId, id], onDelete: Cascade)
  proveedorId String   @db.Uuid
  proveedor   TiendaProveedor @relation(fields: [proveedorId], references: [id], onDelete: Restrict)
  produccion  Int
  envio       Int
  total       Int
  creadoEn    DateTime @default(now())
  /// Saldada: cuándo, quién (usuario) y una nota (p. ej. "transferencia del 3/11").
  saldadaEn   DateTime?
  saldadaPor  String?  @db.Uuid
  notaSaldo   String?

  @@unique([tenantId, pedidoId, proveedorId])
  @@index([tenantId, proveedorId, saldadaEn])
  @@index([proveedorId])
  @@map("tienda_deuda")
}

enum TiendaEstadoOrden {
  EN_PRODUCCION
  DESPACHADO
}

/// Orden de producción: la parte de un pedido pagado que hace un proveedor (una por pedido y
/// proveedor, junto con su deuda). La ve y la despacha el proveedor en su panel
/// (app.<raiz>/portal/tienda); lee entre bandas solo lo suyo (política proveedor_lee).
model TiendaOrden {
  id            String            @id @default(uuid()) @db.Uuid
  tenantId      String            @db.Uuid
  pedidoId      String            @db.Uuid
  pedido        TiendaPedido      @relation(fields: [tenantId, pedidoId], references: [tenantId, id], onDelete: Cascade)
  proveedorId   String            @db.Uuid
  proveedor     TiendaProveedor   @relation(fields: [proveedorId], references: [id], onDelete: Restrict)
  /// Nombre de la banda al pagarse (el proveedor no lee la tabla de bandas).
  bandaNombre   String
  /// Contacto de la banda al pagarse (el proveedor no lee miembros de la banda): el de la tienda
  /// o, si no cargó uno, el mail de un titular.
  contactoNombre   String @default("")
  contactoEmail    String @default("")
  contactoTelefono String @default("")
  estado        TiendaEstadoOrden @default(EN_PRODUCCION)
  /// Número de seguimiento del envío (opcional), lo carga el proveedor al despachar.
  seguimiento   String?
  despachadoEn  DateTime?
  despachadoPor String?           @db.Uuid
  creadoEn      DateTime          @default(now())

  @@unique([tenantId, pedidoId, proveedorId])
  @@index([proveedorId, estado])
  @@map("tienda_orden")
}

/// Datos de la tienda de una banda: el contacto que ven el fan (responder-a) y el proveedor.
model TiendaConfig {
  id               String @id @default(uuid()) @db.Uuid
  tenantId         String @unique @db.Uuid
  contactoNombre   String @default("")
  contactoEmail    String @default("")
  contactoTelefono String @default("")

  @@map("tienda_config")
}
