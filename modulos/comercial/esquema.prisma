// Módulo comercial: planes y cuota mensual de Deoco. Es el gestor de cuenta (gestionaCuenta):
// traduce el plan de cada banda a módulos prendidos y límites, y su pago a un estado.
//
// LA CUOTA ES LA EXCEPCIÓN A LA REGLA DEL DINERO: la banda le paga A DEOCO, en la cuenta de
// Deoco (credenciales del entorno, @/nucleo/pagos/cuota). Estas tablas son SOLO de la cuota;
// las ventas de la banda (tienda, ticketera) nunca pasan por acá.
//
//  - Globales (/// @global): planes y plazos. Las escribe el staff (conStaff).
//  - De banda (tenantId, RLS): la cuenta de cada banda y sus cobros de cuota.
//  - Dominios (comercial_dominio_*): lo que la banda le compra a Deoco. Misma cuenta de Mercado
//    Pago de Deoco, pero NADA en común con la cuota: otras filas, otro aviso, otros estados.
// Dinero: en centavos (Int), pesos argentinos.

/// @global
/// Un plan: lista de módulos + límites + precio. El staff los edita; el código no los conoce.
model ComercialPlan {
  /// "demo", "escenario", "gira", "sello" (los del 3.2).
  id             String   @id
  nombre         String
  /// Para quién es ("Banda que arranca: sitio y press kit").
  descripcion    String   @default("")
  /// Precio de referencia en dólares, solo para mostrar ("8 USD", "a convenir").
  precioUsd      String   @default("")
  /// Lo que se cobra por mes, en centavos de peso. null: sin precio todavía (no se puede elegir).
  precio         Int?
  /// Ids de los módulos que prende.
  modulos        String[]
  /// Bytes para archivos. null: el de la plataforma (DEOCO_LIMITE_ALMACENAMIENTO).
  almacenamiento BigInt?
  /// Topes por límite de módulo: { "tienda.productos-publicados": 20 }. Sin clave (o null): sin tope.
  topes          Json?
  /// false: cerrado (Gira, Sello): no se elige solo; lo asigna el staff.
  aLaVenta       Boolean  @default(true)
  /// Con dominio propio (sin él, el dominio propio de la banda deja de servirse: vuelve el subdominio).
  dominioPropio  Boolean  @default(true)
  orden          Int      @default(0)
  actualizadoEn  DateTime @default(now()) @updatedAt

  @@map("comercial_plan")
}

/// @global
/// Plazos de la cuenta (una sola fila, id 1). Los define el staff en el back office.
model ComercialConfig {
  id                 Int      @id @default(1)
  /// Días de prueba al darse de alta.
  diasPrueba         Int      @default(14)
  /// Plan de la prueba.
  planPrueba         String   @default("escenario")
  /// La escalera de la cuota impaga, en días desde el vencimiento (en orden creciente):
  /// MOROSO: aviso en el panel y por mail.
  diasGracia         Int      @default(3)
  /// MOROSO_GRAVE: aviso permanente en el panel.
  diasAvisoFuerte    Int      @default(15)
  /// SOLO_LECTURA: el panel no guarda nada; el sitio y las ventas siguen.
  diasSoloLectura    Int      @default(30)
  /// SUSPENDIDO: sitio despublicado y ventas cortadas (la puerta sigue para los shows vendidos).
  diasMoraASuspender Int      @default(60)
  /// ARCHIVADO.
  diasArchivo        Int      @default(90)
  actualizadoEn      DateTime @default(now()) @updatedAt

  @@map("comercial_config")
}

/// La cuenta de una banda: su plan, su prueba, su suscripción y su vencimiento.
model ComercialCuenta {
  tenantId          String    @id @db.Uuid
  planId            String
  /// Pro a medida para esta banda (lo arma el staff): { precio, modulos, almacenamiento, topes }.
  pro               Json?
  /// Hasta cuándo dura la prueba (null: no está en prueba).
  pruebaHasta       DateTime?
  /// Plan que eligió y todavía no se aplicó (se aplica al autorizarse la suscripción).
  planElegido       String?
  /// Suscripción en la pasarela de la CUOTA (cuenta de Deoco).
  suscripcionId     String?
  /// pendiente | activa | pausada | cancelada
  suscripcionEstado String?
  medioDePago       String?
  /// Lo que se cobra por mes en la suscripción, en centavos.
  montoSuscripcion  Int?
  proximoCobro      DateTime?
  /// Pagado hasta (vencimiento). null: nunca pagó.
  pagoHasta         DateTime?
  /// Desde cuándo está en mora (null: al día).
  moraDesde         DateTime?
  /// Excedente: el plan no incluye un módulo que sigue prendido porque tiene algo abierto (un show
  /// vendido, pedidos sin despachar). Mientras dure se cobra el plan que lo incluye (`excedentePlanId`).
  excedenteDesde    DateTime?
  excedentePlanId   String?
  /// Prorrateo: diferencia proporcional por subir a mitad de período (centavos), que se suma al
  /// próximo cobro de la suscripción; con ese cobro aprobado vuelve a 0.
  cargoPendiente    Int       @default(0)
  cargoDetalle      String?
  creadoEn          DateTime  @default(now())
  actualizadoEn     DateTime  @default(now()) @updatedAt

  cobros ComercialCobro[]

  @@index([suscripcionId])
  @@map("comercial_cuenta")
}

/// Un cobro mensual de la cuota (aprobado o rechazado), tal como lo informó la pasarela de Deoco.
model ComercialCobro {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  cuenta         ComercialCuenta @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  /// Id en la pasarela (el pago autorizado del mes). Una sola fila por cobro.
  cobroId        String   @unique
  suscripcionId  String?
  /// aprobado | rechazado | pendiente | devuelto
  estado         String
  estadoPasarela String   @default("")
  /// Centavos.
  monto          Int
  fecha          DateTime @default(now())
  creadoEn       DateTime @default(now())

  @@index([tenantId, fecha])
  @@index([estado, fecha])
  @@map("comercial_cobro")
}

/// @global
/// Precio de venta de un dominio por terminación ("com"). Lo fija el staff: costo del
/// registrador + comisión + colchón por el dólar, más la privacidad del WHOIS (incluida en el
/// precio, siempre activada donde la terminación la permite). Sin fila (o no a la venta): no se vende.
model ComercialDominioPrecio {
  tld             String   @id
  /// El registro, por año, en centavos de peso (sin la privacidad).
  precio          Int
  aLaVenta        Boolean  @default(true)
  /// La terminación permite ocultar los datos del titular en el WHOIS. Si no, se le dice a la banda antes de comprar.
  privacidad      Boolean  @default(true)
  /// Lo que cuesta la privacidad, por año, en centavos de peso. Se suma al precio (solo si `privacidad`).
  costoPrivacidad Int      @default(0)
  actualizadoEn   DateTime @default(now()) @updatedAt

  @@map("comercial_dominio_precio")
}

/// Un cobro de un dominio (compra o renovación) en la cuenta de Deoco. NO es la cuota.
model ComercialDominioCobro {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @db.Uuid
  /// alta | renovacion
  tipo          String
  dominio       String
  anios         Int
  /// Centavos.
  monto         Int
  /// Lo mismo no se cobra dos veces: "alta:x.com", "renovacion:x.com:2027-10-15".
  clave         String
  /// Lo que la compra necesita después del pago (titular, aceptación, principal).
  datos         Json
  usuarioId     String?   @db.Uuid
  preferenciaId String?
  /// Hasta cuándo se puede pagar.
  vence         DateTime
  /// esperando | pagado | sin-pagar | devuelto (se devolvió el pago aceptado)
  estado        String    @default("esperando")
  /// El pago aceptado: el que arrancó la compra.
  pagoId        String?
  /// Última vez que se buscaron sus pagos en la pasarela (por si un aviso se perdió).
  revisadoEn    DateTime?
  creadoEn      DateTime  @default(now())
  pagadoEn      DateTime?

  pagos ComercialDominioPago[]

  @@index([tenantId, clave])
  @@map("comercial_dominio_cobro")
}

/// Un pago de la pasarela de Deoco contra un cobro de dominio. Uno aceptado arranca la compra;
/// cualquier otro aprobado (repetido, monto distinto) se devuelve. Las devoluciones se reintentan
/// y, si no salen, quedan a la vista del staff (nunca en silencio).
model ComercialDominioPago {
  id                 String                @id @default(uuid()) @db.Uuid
  tenantId           String                @db.Uuid
  cobroId            String                @db.Uuid
  cobro              ComercialDominioCobro @relation(fields: [cobroId], references: [id], onDelete: Cascade)
  /// Id en la pasarela. Una fila por pago.
  pagoId             String                @unique
  /// aprobado | rechazado | pendiente | devuelto (lo que dice la pasarela)
  estado             String
  estadoPasarela     String                @default("")
  medio              String?
  /// Centavos.
  monto              Int
  moneda             String                @default("ARS")
  /// Arrancar la compra en el núcleo: pendiente | hecha. null: no corresponde.
  entrega            String?
  entregaIntentos    Int                   @default(0)
  entregaError       String?
  /// pendiente | en-proceso | hecha | fallida | a-mano. null: no se devuelve.
  devolucion         String?
  devolucionMotivo   String?
  devolucionIntentos Int                   @default(0)
  devolucionProxima  DateTime?
  devolucionError    String?
  devolucionId       String?
  /// Desde cuándo se está devolviendo (para avisar si tarda).
  devolucionDesde    DateTime?
  devueltoEn         DateTime?
  /// Lo anotó el staff al marcarla devuelta a mano.
  devolucionNota     String?
  tomadoEn           DateTime?
  creadoEn           DateTime              @default(now())
  actualizadoEn      DateTime              @default(now()) @updatedAt

  @@index([tenantId, creadoEn])
  @@map("comercial_dominio_pago")
}
