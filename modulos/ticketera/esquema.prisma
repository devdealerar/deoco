// Módulo ticketera: shows de la banda, tipos de entrada con cupo, compra con la pasarela de la
// banda (núcleo: @/nucleo/pagos) y validación en la puerta. Todo de banda (tenantId + RLS).
// Dinero en centavos (Int). Solo pesos argentinos.

/// Un show. Borrador (publicado = false) no se ve en el sitio.
model TicketeraEvento {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  nombre        String
  /// Día y hora del show.
  fecha         DateTime
  lugar         String
  ciudad        String
  direccion     String   @default("")
  descripcion   String   @default("")
  /// Foto (archivo de la banda, público al publicar).
  fotoArchivoId String?  @db.Uuid
  fotoNombre    String?
  publicado     Boolean  @default(false)
  /// Cuándo se publicó (null en borrador). Si la banda baja de plan, se despublica lo último publicado.
  publicadoEn   DateTime?
  /// Frenos contra el acaparamiento de este show (null = los de la plataforma, `frenosDe`).
  reservaMinutos   Int?
  maxPorCompra     Int?
  maxPorPersona    Int?
  reservasPorEmail Int?
  reservasPorIp    Int?
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @default(now()) @updatedAt

  tipos    TicketeraTipo[]
  compras  TicketeraCompra[]
  entradas TicketeraEntrada[]

  @@unique([tenantId, id])
  @@index([tenantId, fecha])
  @@map("ticketera_evento")
}

/// Tipo de entrada de un show (General, Anticipada…). `ocupadas` = vendidas + reservadas
/// vigentes; la base no deja que pase el cupo (CHECK ocupadas <= cupo).
model TicketeraTipo {
  id         String          @id @default(uuid()) @db.Uuid
  tenantId   String          @db.Uuid
  eventoId   String          @db.Uuid
  evento     TicketeraEvento @relation(fields: [tenantId, eventoId], references: [tenantId, id], onDelete: Cascade)
  nombre     String
  /// Centavos.
  precio     Int
  cupo       Int
  ocupadas   Int             @default(0)
  /// Ventana de venta (null: sin límite de ese lado).
  ventaDesde DateTime?
  ventaHasta DateTime?
  creadoEn   DateTime        @default(now())

  compras  TicketeraCompra[]
  entradas TicketeraEntrada[]

  @@unique([tenantId, id])
  @@index([tenantId, eventoId])
  @@map("ticketera_tipo")
}

/// RESERVADA: esperando el pago (ocupa cupo hasta `venceEn`). PAGADA: con sus entradas.
/// VENCIDA: no se pagó a tiempo (liberó el cupo). EN_REVISION: pago que no coincide o llegó
/// tarde sin cupo: la banda lo devuelve (está en sus pagos para devolver). DEVUELTA: la
/// pasarela devolvió o contracargó el pago: las entradas dejan de valer y el lugar vuelve.
enum TicketeraEstadoCompra {
  RESERVADA
  PAGADA
  VENCIDA
  EN_REVISION
  DEVUELTA
}

/// Compra de un fan: un tipo, una cantidad, una entrada nominada por persona.
model TicketeraCompra {
  id             String                @id @default(uuid()) @db.Uuid
  tenantId       String                @db.Uuid
  eventoId       String                @db.Uuid
  evento         TicketeraEvento       @relation(fields: [tenantId, eventoId], references: [tenantId, id], onDelete: Restrict)
  tipoId         String                @db.Uuid
  tipo           TicketeraTipo         @relation(fields: [tenantId, tipoId], references: [tenantId, id], onDelete: Restrict)
  estado         TicketeraEstadoCompra @default(RESERVADA)
  cantidad       Int
  /// Copias al comprar (centavos).
  precioUnitario Int
  total          Int
  /// Quien compra (le llega el mail con las entradas).
  nombre         String
  email          String
  /// Una por entrada: [{ "nombre": "...", "documento": "..." }]
  asistentes     Json
  venceEn        DateTime
  pasarela       String?
  preferenciaId  String?
  urlPago        String?
  cobroId        String?
  estadoCobro    String?
  pagadaEn       DateTime?
  /// Por qué quedó EN_REVISION, o pagos duplicados.
  observacion    String?
  /// DEVUELTA: cuándo, y si fue un contracargo (el comprador desconoció el pago).
  devueltaEn     DateTime?
  contracargo    Boolean               @default(false)
  /// Freno de acaparamiento: hash de la IP de quien reservó (nunca la IP).
  ipHash         String?
  /// Conciliación: la última vez que se le preguntó a la pasarela.
  conciliadaEn   DateTime?
  /// DNI o CUIT de quien compra, si lo dio (para la factura).
  documento      String?
  /// Foto fiscal al pagarse (`@/nucleo/fiscal`): vendedor, comprador, renglones e impuestos.
  fiscal         Json?
  /// Secreto del link para volver a ver las entradas (/fechas/compra/<id>#<token>): el id solo
  /// no alcanza, las entradas dejan entrar. En la base nunca en claro: el hash para comprobarlo y
  /// el cifrado para armar el link (`@/nucleo/publico/token`; null en compras de antes).
  tokenHash      String
  tokenCifrado   Bytes?
  creadoEn       DateTime              @default(now())

  entradas TicketeraEntrada[]

  @@unique([tenantId, id])
  @@index([tenantId, tipoId, estado])
  @@map("ticketera_compra")
}

/// Una entrada nominada (existe solo pagada). `codigo` va en el QR y se tipea en la puerta.
model TicketeraEntrada {
  id              String          @id @default(uuid()) @db.Uuid
  tenantId        String          @db.Uuid
  compraId        String          @db.Uuid
  compra          TicketeraCompra @relation(fields: [tenantId, compraId], references: [tenantId, id], onDelete: Cascade)
  eventoId        String          @db.Uuid
  evento          TicketeraEvento @relation(fields: [tenantId, eventoId], references: [tenantId, id], onDelete: Restrict)
  tipoId          String          @db.Uuid
  tipo            TicketeraTipo   @relation(fields: [tenantId, tipoId], references: [tenantId, id], onDelete: Restrict)
  nombre          String
  documento       String
  codigo          String
  /// La compra se devolvió (o contracargó): la entrada ya no deja entrar.
  anuladaEn       DateTime?
  /// Validada en la puerta: cuándo, quién y con qué intento (un reintento del mismo pedido
  /// por mala señal responde "válida" de nuevo, no "ya validada").
  validadaEn      DateTime?
  validadaPor     String?         @db.Uuid
  validadaIntento String?

  @@unique([tenantId, codigo])
  @@index([tenantId, eventoId])
  @@map("ticketera_entrada")
}
