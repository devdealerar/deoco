// Esquema del núcleo de Deoco. Los módulos traen el suyo en modulos/<id>/esquema.prisma
// (se copia a prisma/schema/modulos/ al descubrir módulos; ver docs/guia-modulos.md).
// Regla: toda tabla con datos de banda lleva `tenantId` y su política RLS
// (ver prisma/migrations/*_rls). Sin eso, no se mergea.

generator client {
  provider = "prisma-client"
  output   = "../../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


// ACTIVO y MOROSO: todo funciona (MOROSO avisa al titular).
// SUSPENDIDO: panel 403 salvo rutas de pago (solo titular); sitio público normal.
// ARCHIVADO: panel y sitio 404; los datos se conservan.
// Las reglas viven en src/nucleo/tenant/reglas.ts.
/// Escalera de la cuota impaga (los días los fija el gestor de cuenta, contados desde el vencimiento):
/// ACTIVO → MOROSO (aviso) → MOROSO_GRAVE (aviso permanente) → SOLO_LECTURA (el panel no guarda
/// nada; el sitio y las ventas siguen) → SUSPENDIDO (sitio despublicado, ventas cortadas; la puerta
/// sigue para los shows vendidos) → ARCHIVADO.
enum EstadoTenant {
  ACTIVO
  MOROSO
  MOROSO_GRAVE
  SOLO_LECTURA
  SUSPENDIDO
  ARCHIVADO
}

/// Identidad global: una persona, un usuario, en toda la plataforma. Sin RLS.
model Usuario {
  id             String      @id @default(uuid()) @db.Uuid
  email          String      @unique
  nombre         String
  hashContrasena String
  /// Clave dada por el staff (alta o invitación): hay que cambiarla antes de usar el panel.
  claveTemporal  Boolean     @default(false)
  /// La sesión (JWT) guarda con qué versión se abrió; si cambia (al cambiar la clave, o el staff
  /// cierra las sesiones), en el próximo pedido deja de valer.
  versionSesion  Int         @default(0)
  esStaff        Boolean     @default(false)
  creadoEn       DateTime    @default(now())
  membresias     Membresia[]
  eventos        Evento[]
  cuentasExternas CuentaExterna[]

  @@map("usuario")
}

/// La banda. RLS por `id` (es su propio tenant).
model Tenant {
  id                   String         @id @default(uuid()) @db.Uuid
  nombre               String
  slug                 String         @unique
  estado               EstadoTenant   @default(ACTIVO)
  /// Espacio para archivos, en bytes. null = DEOCO_LIMITE_ALMACENAMIENTO. Lo fija un plan (el núcleo no los conoce).
  limiteAlmacenamiento BigInt?
  /// Dominio propio según el plan (lo fija el gestor). false: el dominio propio de la banda deja de
  /// servirse (el proxy manda al subdominio) y no se suman nuevos; nada se borra.
  dominiosPropios      Boolean        @default(true)
  /// "staff" (alta en el back office) o "autogestion" (la persona sola, en /registro).
  origen               String         @default("staff")
  /// Quién la creó, en autogestión (una por cuenta).
  creadoPor            String?        @db.Uuid
  creadoEn             DateTime       @default(now())
  membresias           Membresia[]
  dominios             Dominio[]
  modulos              ModuloTenant[]
  eventos              Evento[]
  archivos             Archivo[]
  secretos             Secreto[]
  correos              Correo[]
  cobrosDuplicados     CobroDuplicado[]
  correoDominio        CorreoDominio?
  zonasSalientes       ZonaSaliente[]
  registradorClientes  RegistradorCliente[]
  comprasDeDominio     DominioCompra[]
  datosFiscales        DatosFiscales?
  limites              LimiteBanda[]

  @@map("tenant")
}

model Membresia {
  id        String  @id @default(uuid()) @db.Uuid
  usuarioId String  @db.Uuid
  tenantId  String  @db.Uuid
  /// TITULAR, EDITOR, LECTURA (núcleo) o uno que declare un módulo (PUERTA, COMERCIAL…).
  rol       String
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, tenantId])
  @@index([tenantId])
  @@map("membresia")
}

/// Un host resuelve solo si está verificado. Sin verificar, el mismo dominio puede estar
/// registrado en varias bandas: lo gana la que prueba que es suya (registro TXT con su
/// `token`; delegado, la que tiene la zona activa). Únicos (índices parciales en la
/// migración): un verificado por dominio y un principal por banda; el principal siempre está
/// verificado.
model Dominio {
  id           String    @id @default(uuid()) @db.Uuid
  dominio      String
  tenantId     String    @db.Uuid
  esPrincipal  Boolean   @default(false)
  verificado   Boolean   @default(false)
  token        String    @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  verificadoEn DateTime?
  /// Última revisión periódica del DNS (solo propios verificados).
  revisadoEn     DateTime?
  /// Revisiones seguidas en que no apuntó al servidor.
  fallasSeguidas Int       @default(0)
  /// Desde cuándo tiene un problema (dos revisiones seguidas). Null = bien.
  problemaDesde  DateTime?
  /// El problema, como lo ve la banda ("Tu CNAME dejó de apuntar a Deoco").
  problema       String?
  /// Por dónde llega a Deoco: "cname" (custom hostname) o "zona" (delegado). Null: subdominio de la plataforma.
  via             String?
  /// Id en Cloudflare: el custom hostname o la zona.
  proveedorId     String?
  /// Último estado que informó Cloudflare (hostname o zona: "active", "pending", …).
  estadoProveedor String?
  /// Último estado del certificado ("active" = listo para ser principal).
  certificado     String?
  /// cname: registros de validación que pidió Cloudflare (por si tarda). zona: los registros que
  /// trajo de su DNS anterior (para que la banda los revise). [{ tipo, nombre, valor }]
  validacion      Json      @default("[]")
  /// Delegado: los nameservers de la zona (los que la banda pone en su registrador).
  nameservers     String[]  @default([])
  /// Desde cuándo está en la banda (una delegación que nadie completa vence a los 14 días).
  creadoEn        DateTime  @default(now())
  /// Conectado por CNAME pasándose a delegado: la zona a la que va (sigue andando por CNAME).
  migrandoA       String?
  /// Ya delegado: el custom hostname viejo, a borrar cuando el certificado de la zona esté activo.
  hostnameViejo   String?
  /// Comprado en Deoco: su zona la maneja la compra (no vence como una delegación).
  comprado        Boolean   @default(false)
  /// Cuándo vence el registro (comprado: del registrador; delegado: lo carga la banda).
  venceEn               DateTime?
  /// Comprado que venció sin renovar: el sitio volvió al subdominio, nada se borra.
  vencidoEn             DateTime?
  /// Era el principal al vencer: renovado, vuelve a serlo.
  vencidoEraPrincipal   Boolean   @default(false)
  /// La banda pidió el código para llevárselo a otro registrador.
  transferenciaPedidaEn DateTime?
  /// Comprado cuyo DNS se llevó la banda: sigue registrado en Deoco, pero ya no llega acá.
  soloRegistro          Boolean   @default(false)
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  correo       CorreoDominio[]

  @@unique([tenantId, dominio])
  @@index([dominio])
  @@index([tenantId])
  @@map("dominio")
}

/// Presencia de la fila = módulo prendido para esa banda.
model ModuloTenant {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  moduloId String
  /// Prendido como excedente: el plan ya no lo incluye pero tiene operaciones abiertas
  /// (`enCurso` del módulo). El gestor lo apaga cuando se cierran. null: prendido normal.
  excedenteDesde  DateTime?
  excedenteMotivo String?
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, moduloId])
  @@map("moduloTenant")
}

enum EstadoEvento {
  PENDIENTE
  PROCESADO
  FALLIDO
}

/// Bitácora del bus de eventos (src/nucleo/eventos). Índices parciales (en las migraciones, Prisma
/// no los declara): `evento_pendiente` (barrido) y `evento_fallido` (fallidos del back office).
model Evento {
  id          String       @id @default(uuid()) @db.Uuid
  /// Orden de emisión: los eventos de una banda se procesan por este número.
  secuencia   BigInt       @unique @default(autoincrement())
  nombre      String
  tenantId    String       @db.Uuid
  usuarioId   String?      @db.Uuid
  fecha       DateTime     @default(now())
  payload     Json
  estado      EstadoEvento @default(PENDIENTE)
  intentos    Int          @default(0)
  /// Un registro por cada suscripto que falló: { intento, moduloId, error, fecha }.
  fallos      Json         @default("[]")
  /// Al reprocesar: solo estos suscriptos (los que fallaron). Vacío = todos.
  soloPara    String[]     @default([])
  procesadoEn DateTime?
  /// Mientras se entrega: cuándo se tomó. Se suelta al terminar; uno colgado se retoma.
  tomadoEn    DateTime?
  /// Idempotencia: el mismo (banda, nombre, claveUnica) se guarda una sola vez (p. ej. el id
  /// del pago en un aviso de pasarela repetido). Null = sin control.
  claveUnica  String?
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  usuario     Usuario?     @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@unique([tenantId, nombre, claveUnica])
  @@index([tenantId, nombre])
  @@index([tenantId, estado, secuencia])
  @@map("evento")
}

/// Archivos subidos por los módulos (src/nucleo/archivos). El contenido vive en el
/// almacén (disco del VPS hoy); acá queda lo necesario para servirlo y medir la cuota.
model Archivo {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  /// Módulo dueño del archivo.
  moduloId  String
  /// Recurso del módulo ("diseno", "logo"…: `archivos` en su contrato). En el panel se entrega con
  /// el permiso de ese recurso. null (archivos viejos que no se pudieron deducir): solo el titular.
  recurso   String?
  /// Nombre original, para la descarga.
  nombre    String
  /// jpeg | png | webp | pdf | svg (detectado por contenido, no por extensión)
  tipo      String
  /// Original + versiones livianas: lo que cuenta para la cuota.
  bytes     BigInt
  /// Versiones livianas generadas (p. ej. "web"), en WebP.
  variantes String[] @default([])
  /// Se sirve en el sitio público. Lo decide el módulo (p. ej. al publicar).
  publico   Boolean  @default(false)
  creadoEn  DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, moduloId])
  @@map("archivo")
}

/// Auditoría: accesos del staff a una banda y toda acción del back office.
/// Qué (accion), quién (usuarioId), cuándo (fecha), sobre qué banda (tenantId; null =
/// de plataforma, p. ej. crear un usuario). Solo se agregan filas, nunca se editan.
model Auditoria {
  id        String   @id @default(uuid()) @db.Uuid
  fecha     DateTime @default(now())
  /// null: lo hizo la plataforma sola (p. ej. el gestor de cuenta por un pago); `detalle.por` dice quién.
  usuarioId String?  @db.Uuid
  tenantId  String?  @db.Uuid
  /// "banda.creada", "banda.estado_cambiado", "acceso.panel"...
  accion    String
  detalle   Json     @default("{}")

  @@index([tenantId, fecha])
  @@index([usuarioId, fecha])
  @@map("auditoria")
}

/// Credencial de una banda para un módulo (p. ej. el token de una pasarela). El valor va
/// cifrado (AES-256-GCM, clave DEOCO_CLAVE_SECRETOS) y atado a banda + módulo + clave: no
/// se puede copiar a otra fila. Lo carga solo el titular; lo lee solo el módulo dueño.
model Secreto {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  moduloId       String
  /// Declarada por el módulo en su contrato (`secretos`).
  clave          String
  cifrado        Bytes
  /// Últimos caracteres para reconocerlo en pantalla ("…a1b2"); vacío si es corto.
  pista          String   @default("")
  actualizadoEn  DateTime @default(now()) @updatedAt
  actualizadoPor String   @db.Uuid
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, moduloId, clave])
  @@map("secreto")
}

enum EstadoCorreo {
  PENDIENTE
  ENVIANDO
  ENVIADO
  FALLIDO
}

/// Correo saliente de una banda (confirmación al fan, orden al proveedor). Se guarda en la
/// transacción de quien lo pide y sale después de responder. `claveUnica`: el mismo correo
/// no sale dos veces aunque se pida de nuevo (p. ej. un aviso de pago repetido).
model Correo {
  id              String       @id @default(uuid()) @db.Uuid
  tenantId        String       @db.Uuid
  /// Módulo que lo pidió ("nucleo": un aviso de Deoco, enviarCorreoDelNucleo).
  moduloId        String
  para            String
  responderA      String?
  /// Nombre que ve el destinatario como remitente (la banda). La dirección es la de Deoco.
  nombreRemitente String
  asunto          String
  html            String
  texto           String
  estado          EstadoCorreo @default(PENDIENTE)
  intentos        Int          @default(0)
  error           String?
  claveUnica      String?
  /// [{ nombre, tipo, cid?, base64 }]: imágenes embebidas (cid:) o archivos adjuntos.
  adjuntos        Json         @default("[]")
  creadoEn        DateTime     @default(now())
  enviadoEn       DateTime?
  /// Cuándo se tomó para enviar (uno colgado en ENVIANDO lo marca el barrido).
  tomadoEn        DateTime?
  /// FALLIDO que el barrido reintenta solo a partir de esta fecha. Null = no se reintenta solo.
  reintentarEn    DateTime?
  tenant          Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, claveUnica])
  @@index([tenantId, estado])
  @@map("correo")
}

/// Archivo de la plataforma, no de una banda (la foto de un producto del catálogo base).
/// Siempre público: se sirve en cualquier host en /archivos/plataforma/<id>/<nombre>.
/// Todos lo leen; solo se escribe dentro de conStaff() (deoco_tabla_global).
model ArchivoPlataforma {
  id        String   @id @db.Uuid
  /// Módulo dueño del archivo.
  moduloId  String
  nombre    String
  tipo      String
  bytes     BigInt
  variantes String[] @default([])
  creadoEn  DateTime @default(now())

  @@map("archivo_plataforma")
}

/// Cuenta externa: un usuario vinculado a algo de un módulo (el proveedor de la tienda), no a
/// una banda. Entra por app.<raiz>/portal/<modulo>. La crea el staff (conStaff); todos la leen.
model CuentaExterna {
  id         String   @id @default(uuid()) @db.Uuid
  usuarioId  String   @db.Uuid
  moduloId   String
  /// Lo que el módulo vincula (el id del proveedor). El núcleo no sabe qué es.
  referencia String
  creadoEn   DateTime @default(now())
  creadoPor  String   @db.Uuid
  usuario    Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, moduloId])
  @@index([moduloId, referencia])
  @@map("cuenta_externa")
}

/// Un PAGO PARA DEVOLVER (el nombre de la tabla quedó de cuando solo eran duplicados): aprobado
/// en la cuenta de la banda pero que no se entrega, porque lo cobrado ya estaba pagado
/// (duplicado), ya había vencido (tardío) o no coincide. La banda lo ve en /b/<slug>/devoluciones
/// y lo devuelve: desde Deoco (con SU cuenta: la plata vuelve de la banda al fan) o por su lado.
/// Lo escribe registrarCobro() (src/nucleo/pagos/registro.ts), para todo módulo que cobra.
/// `referencia`: lo que el módulo mandó a cobrar (no tiene FK: es del módulo).
model CobroDuplicado {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  moduloId   String
  referencia String
  pasarela   String
  cobroId    String
  /// Centavos.
  monto      Int
  moneda     String
  /// duplicado | tardio (llegó con lo comprado ya vencido) | no-coincide (monto o moneda).
  motivo     String   @default("duplicado")
  detalle    String?
  creadoEn   DateTime @default(now())
  /// Resuelto: devuelto desde Deoco con la cuenta de la banda (`devolucionId`), marcado a mano
  /// por la banda (`nota`), o la pasarela avisó que se devolvió.
  devueltoEn   DateTime?
  devueltoPor  String?  @db.Uuid
  devolucionId String?
  nota         String?

  @@unique([tenantId, pasarela, cobroId])
  @@index([tenantId, moduloId, referencia])
  @@map("cobro_duplicado")
}

/// Tope de un límite de módulo (`<modulo>.<clave>`, p. ej. "tienda.productos-publicados") para una
/// banda. Lo fija el gestor de cuenta; sin fila, no hay tope. El núcleo no sabe de planes.
model LimiteBanda {
  tenantId String @db.Uuid
  limite   String
  maximo   Int
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, limite])
  @@map("limite_banda")
}

/// Registro sin verificar (autogestión). Nadie lo lee: solo registro_solicitar/registro_confirmar.
model RegistroPendiente {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email          String   @unique
  nombre         String
  hashContrasena String
  tokenHash      String   @unique
  venceEn        DateTime
  envios         Int      @default(1)
  ultimoEnvio    DateTime @default(now())
  creadoEn       DateTime @default(now())

  @@map("registro_pendiente")
}

/// Correo desde el dominio de la banda: la dirección de envío (Resend) y el reenvío de lo que
/// llega (solo dominios delegados sin correo propio). Una por banda.
model CorreoDominio {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @unique @db.Uuid
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  dominioId   String    @db.Uuid
  dominioFila Dominio   @relation(fields: [dominioId], references: [id], onDelete: Cascade)
  /// Sin www: labanda.com.
  dominio     String
  /// merch@labanda.com → "merch".
  local       String
  /// Resend: id del dominio y estado (pendiente | verificado | fallido).
  envioId     String?
  envioEstado String    @default("pendiente")
  /// Los registros DNS que pide Resend: [{ tipo, nombre, valor, para }].
  registros   Json      @default("[]")
  /// no (conectado por CNAME) | propio (ya tiene MX, no se toca) | activa (Email Routing → Worker).
  recepcion   String    @default("no")
  reenvioA    String?
  revisadoEn  DateTime?
  creadoEn    DateTime  @default(now())

  @@map("correo_dominio")
}

/// Una zona delegada de la que la banda se está yendo (se lleva el DNS o quitó el dominio).
/// Sigue andando hasta que los nameservers se van, o hasta `bajaEn` (90 días).
model ZonaSaliente {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @db.Uuid
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  zonaId         String
  /// Sin www.
  dominio        String
  /// "Me llevo el DNS" (true) o quitó el dominio (false).
  seLlevaElDns   Boolean   @default(false)
  /// Seguir con el sitio en Deoco por CNAME (www).
  seguirConSitio Boolean   @default(false)
  hostnameId     String?
  /// Lo que tiene que cargar en su DNS nuevo: [{ tipo, nombre, valor, para, prioridad? }].
  registros      Json      @default("[]")
  desde          DateTime  @default(now())
  bajaEn         DateTime
  avisadoEn      DateTime?
  revisadoEn     DateTime?

  @@unique([tenantId, zonaId])
  @@map("zona_saliente")
}

/// La subcuenta de la banda en el registrador (una por banda y registrador).
model RegistradorCliente {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  registrador String
  clienteId   String
  creadoEn    DateTime @default(now())

  @@unique([tenantId, registrador])
  @@map("registrador_cliente")
}

/// Una compra (alta) o renovación de un dominio, ya pagada, con su paso actual
/// (src/nucleo/dominios/compra.ts). Avanza desde el barrido; nunca registra dos veces.
model DominioCompra {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @db.Uuid
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  usuarioId      String?   @db.Uuid
  /// alta | renovacion | titular (cambio de titular registral) | dns (nameservers de la banda); los dos últimos sin cobro
  tipo           String
  dominio        String
  registrador    String
  anios          Int       @default(1)
  /// El titular registral (Contacto).
  contacto       Json      @default("{}")
  /// { fecha, ip, claves }
  aceptacion     Json      @default("{}")
  hacerPrincipal Boolean   @default(false)
  /// Con privacidad del WHOIS (la banda la pagó en el precio; sale de la terminación al cobrar).
  privacidad     Boolean   @default(false)
  cobroId        String
  /// Centavos de peso.
  monto          Int
  /// en-curso | datos | listo | fallido
  estado         String    @default("en-curso")
  paso           String
  /// La operación del registrador en curso: { id, estado }.
  operacion      Json?
  intentos       Int       @default(0)
  proximoIntento DateTime  @default(now())
  primerFalloEn  DateTime?
  error          String?
  motivo         String?
  campo          String?
  /// Desde cuándo espera un dato del titular (estado "datos"): a los 7 días se devuelve.
  datosDesde     DateTime?
  /// pendiente (sin pedir al gestor) | pedida (la tiene el gestor)
  devolucion     String?
  venceEn        DateTime?
  tomadoEn       DateTime?
  creadoEn       DateTime  @default(now())
  terminadoEn    DateTime?

  @@unique([tenantId, cobroId])
  @@map("dominio_compra")
}

/// Datos fiscales de la banda (3.2, fiscal d1): cada venta guarda una foto de esto al pagarse
/// (`@/nucleo/fiscal`). Sin fila, "sin_declarar". Todavía sin pantalla ni facturación.
model DatosFiscales {
  tenantId      String   @id @db.Uuid
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// responsable_inscripto | monotributo | exento | sin_declarar
  condicion     String   @default("sin_declarar")
  cuit          String?
  razonSocial   String?
  actualizadoEn DateTime @default(now())

  @@map("datos_fiscales")
}
