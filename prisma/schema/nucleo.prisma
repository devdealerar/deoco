// Esquema del núcleo de Deoco. Los módulos traen el suyo en modulos/<id>/esquema.prisma
// (se copia a prisma/schema/modulos/ al descubrir módulos; ver docs/guia-modulos.md).
// Regla: toda tabla con datos de banda lleva `tenantId` y su política RLS
// (ver prisma/migrations/*_rls). Sin eso, no se mergea.

generator client {
  provider = "prisma-client"
  output   = "../../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Rol {
  TITULAR
  EDITOR
  COMERCIAL
  PUERTA
  LECTURA
}

// ACTIVO y MOROSO: todo funciona (MOROSO avisa al titular).
// SUSPENDIDO: panel 403 salvo rutas de pago (solo titular); sitio público normal.
// ARCHIVADO: panel y sitio 404; los datos se conservan.
// Las reglas viven en src/nucleo/tenant/reglas.ts.
enum EstadoTenant {
  ACTIVO
  MOROSO
  SUSPENDIDO
  ARCHIVADO
}

/// Identidad global: una persona, un usuario, en toda la plataforma. Sin RLS.
model Usuario {
  id             String      @id @default(uuid()) @db.Uuid
  email          String      @unique
  nombre         String
  hashContrasena String
  /// Clave dada por el staff (alta o invitación): hay que cambiarla antes de usar el panel.
  claveTemporal  Boolean     @default(false)
  esStaff        Boolean     @default(false)
  creadoEn       DateTime    @default(now())
  membresias     Membresia[]
  eventos        Evento[]
  cuentasExternas CuentaExterna[]

  @@map("usuario")
}

/// La banda. RLS por `id` (es su propio tenant).
model Tenant {
  id                   String         @id @default(uuid()) @db.Uuid
  nombre               String
  slug                 String         @unique
  estado               EstadoTenant   @default(ACTIVO)
  /// Espacio para archivos, en bytes. null = DEOCO_LIMITE_ALMACENAMIENTO. Lo fija un plan (el núcleo no los conoce).
  limiteAlmacenamiento BigInt?
  creadoEn             DateTime       @default(now())
  membresias           Membresia[]
  dominios             Dominio[]
  modulos              ModuloTenant[]
  eventos              Evento[]
  archivos             Archivo[]
  secretos             Secreto[]
  correos              Correo[]

  @@map("tenant")
}

model Membresia {
  id        String  @id @default(uuid()) @db.Uuid
  usuarioId String  @db.Uuid
  tenantId  String  @db.Uuid
  rol       Rol
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, tenantId])
  @@index([tenantId])
  @@map("membresia")
}

/// Un host resuelve solo si está verificado. Sin verificar, el mismo dominio puede estar
/// registrado en varias bandas: lo gana la que prueba que es suya (registro TXT con su
/// `token`). Únicos (índices parciales en la migración): un verificado por dominio y un
/// principal por banda; el principal siempre está verificado.
model Dominio {
  id           String    @id @default(uuid()) @db.Uuid
  dominio      String
  tenantId     String    @db.Uuid
  esPrincipal  Boolean   @default(false)
  verificado   Boolean   @default(false)
  token        String    @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  verificadoEn DateTime?
  /// Última revisión periódica del DNS (solo propios verificados).
  revisadoEn     DateTime?
  /// Revisiones seguidas en que no apuntó al servidor.
  fallasSeguidas Int       @default(0)
  /// Desde cuándo no apunta al servidor (dos revisiones seguidas). Null = bien.
  noApuntaDesde  DateTime?
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, dominio])
  @@index([dominio])
  @@index([tenantId])
  @@map("dominio")
}

/// Presencia de la fila = módulo prendido para esa banda.
model ModuloTenant {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  moduloId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, moduloId])
  @@map("moduloTenant")
}

enum EstadoEvento {
  PENDIENTE
  PROCESADO
  FALLIDO
}

/// Bitácora del bus de eventos (src/nucleo/eventos).
model Evento {
  id          String       @id @default(uuid()) @db.Uuid
  /// Orden de emisión: los eventos de una banda se procesan por este número.
  secuencia   BigInt       @unique @default(autoincrement())
  nombre      String
  tenantId    String       @db.Uuid
  usuarioId   String?      @db.Uuid
  fecha       DateTime     @default(now())
  payload     Json
  estado      EstadoEvento @default(PENDIENTE)
  intentos    Int          @default(0)
  /// Un registro por cada suscripto que falló: { intento, moduloId, error, fecha }.
  fallos      Json         @default("[]")
  /// Al reprocesar: solo estos suscriptos (los que fallaron). Vacío = todos.
  soloPara    String[]     @default([])
  procesadoEn DateTime?
  /// Mientras se entrega: cuándo se tomó. Se suelta al terminar; uno colgado se retoma.
  tomadoEn    DateTime?
  /// Idempotencia: el mismo (banda, nombre, claveUnica) se guarda una sola vez (p. ej. el id
  /// del pago en un aviso de pasarela repetido). Null = sin control.
  claveUnica  String?
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  usuario     Usuario?     @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@unique([tenantId, nombre, claveUnica])
  @@index([tenantId, nombre])
  @@index([tenantId, estado, secuencia])
  @@map("evento")
}

/// Archivos subidos por los módulos (src/nucleo/archivos). El contenido vive en el
/// almacén (disco del VPS hoy); acá queda lo necesario para servirlo y medir la cuota.
model Archivo {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  /// Módulo dueño del archivo.
  moduloId  String
  /// Nombre original, para la descarga.
  nombre    String
  /// jpeg | png | webp | pdf | svg (detectado por contenido, no por extensión)
  tipo      String
  /// Original + versiones livianas: lo que cuenta para la cuota.
  bytes     BigInt
  /// Versiones livianas generadas (p. ej. "web"), en WebP.
  variantes String[] @default([])
  /// Se sirve en el sitio público. Lo decide el módulo (p. ej. al publicar).
  publico   Boolean  @default(false)
  creadoEn  DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, moduloId])
  @@map("archivo")
}

/// Auditoría: accesos del staff a una banda y toda acción del back office.
/// Qué (accion), quién (usuarioId), cuándo (fecha), sobre qué banda (tenantId; null =
/// de plataforma, p. ej. crear un usuario). Solo se agregan filas, nunca se editan.
model Auditoria {
  id        String   @id @default(uuid()) @db.Uuid
  fecha     DateTime @default(now())
  usuarioId String   @db.Uuid
  tenantId  String?  @db.Uuid
  /// "banda.creada", "banda.estado_cambiado", "acceso.panel"...
  accion    String
  detalle   Json     @default("{}")

  @@index([tenantId, fecha])
  @@index([usuarioId, fecha])
  @@map("auditoria")
}

/// Credencial de una banda para un módulo (p. ej. el token de una pasarela). El valor va
/// cifrado (AES-256-GCM, clave DEOCO_CLAVE_SECRETOS) y atado a banda + módulo + clave: no
/// se puede copiar a otra fila. Lo carga solo el titular; lo lee solo el módulo dueño.
model Secreto {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  moduloId       String
  /// Declarada por el módulo en su contrato (`secretos`).
  clave          String
  cifrado        Bytes
  /// Últimos caracteres para reconocerlo en pantalla ("…a1b2"); vacío si es corto.
  pista          String   @default("")
  actualizadoEn  DateTime @default(now()) @updatedAt
  actualizadoPor String   @db.Uuid
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, moduloId, clave])
  @@map("secreto")
}

enum EstadoCorreo {
  PENDIENTE
  ENVIANDO
  ENVIADO
  FALLIDO
}

/// Correo saliente de una banda (confirmación al fan, orden al proveedor). Se guarda en la
/// transacción de quien lo pide y sale después de responder. `claveUnica`: el mismo correo
/// no sale dos veces aunque se pida de nuevo (p. ej. un aviso de pago repetido).
model Correo {
  id              String       @id @default(uuid()) @db.Uuid
  tenantId        String       @db.Uuid
  /// Módulo que lo pidió.
  moduloId        String
  para            String
  responderA      String?
  /// Nombre que ve el destinatario como remitente (la banda). La dirección es la de Deoco.
  nombreRemitente String
  asunto          String
  html            String
  texto           String
  estado          EstadoCorreo @default(PENDIENTE)
  intentos        Int          @default(0)
  error           String?
  claveUnica      String?
  /// [{ nombre, tipo, cid?, base64 }]: imágenes embebidas (cid:) o archivos adjuntos.
  adjuntos        Json         @default("[]")
  creadoEn        DateTime     @default(now())
  enviadoEn       DateTime?
  /// Cuándo se tomó para enviar (uno colgado en ENVIANDO lo marca el barrido).
  tomadoEn        DateTime?
  /// FALLIDO que el barrido reintenta solo a partir de esta fecha. Null = no se reintenta solo.
  reintentarEn    DateTime?
  tenant          Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, claveUnica])
  @@index([tenantId, estado])
  @@map("correo")
}

/// Archivo de la plataforma, no de una banda (la foto de un producto del catálogo base).
/// Siempre público: se sirve en cualquier host en /archivos/plataforma/<id>/<nombre>.
/// Todos lo leen; solo se escribe dentro de conStaff() (deoco_tabla_global).
model ArchivoPlataforma {
  id        String   @id @db.Uuid
  /// Módulo dueño del archivo.
  moduloId  String
  nombre    String
  tipo      String
  bytes     BigInt
  variantes String[] @default([])
  creadoEn  DateTime @default(now())

  @@map("archivo_plataforma")
}

/// Cuenta externa: un usuario vinculado a algo de un módulo (el proveedor de la tienda), no a
/// una banda. Entra por app.<raiz>/portal/<modulo>. La crea el staff (conStaff); todos la leen.
model CuentaExterna {
  id         String   @id @default(uuid()) @db.Uuid
  usuarioId  String   @db.Uuid
  moduloId   String
  /// Lo que el módulo vincula (el id del proveedor). El núcleo no sabe qué es.
  referencia String
  creadoEn   DateTime @default(now())
  creadoPor  String   @db.Uuid
  usuario    Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, moduloId])
  @@index([moduloId, referencia])
  @@map("cuenta_externa")
}
